<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo per Azure App Service su WINDOWS (iisnode). Su App Service Linux
  questo file viene ignorato: lì basta lo startup command "node server.js".
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Tutte le richieste passano da server.js (che gestisce statici + fallback SPA) -->
        <rule name="ferie-node">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
